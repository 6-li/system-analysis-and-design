page{background:#f3f6f5;color:#203d3a;font-family:-apple-system,BlinkMacSystemFont,"Helvetica Neue","PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
.card{margin:0;padding:32rpx 32rpx 56rpx;padding-bottom:calc(56rpx + env(safe-area-inset-bottom));min-height:100vh;box-sizing:border-box}
.brand-line{display:flex;align-items:center;gap:16rpx;margin:4rpx 0 30rpx}
.brand-mark{font-size:26rpx;letter-spacing:3rpx;font-weight:800;color:#16776b}
.brand-caption{font-size:22rpx;color:#748a85;border-left:1rpx solid #cbd8d4;padding-left:16rpx}
.title{font-size:42rpx;font-weight:700;line-height:1.35;letter-spacing:1rpx;margin:0 0 32rpx}
.intro{color:#6b807b;font-size:28rpx;margin-bottom:36rpx}
.section-heading{font-size:31rpx;font-weight:700;margin:36rpx 0 20rpx;line-height:1.5}
.field{margin:26rpx 0}
.field label{display:block;font-weight:600;font-size:27rpx;margin-bottom:14rpx}
.field input,.field textarea,.date-choice{box-sizing:border-box;width:100%;padding:22rpx 24rpx;background:#fff;border:2rpx solid #d9e3df;border-radius:18rpx;font-size:29rpx;color:#203d3a;line-height:1.6}
.field input{height:96rpx}
.field textarea{min-height:150rpx;padding-top:20rpx;padding-bottom:20rpx}
.field input[disabled]{background:#eaf0ed;color:#627973}
.date-choice{min-height:96rpx;padding-right:54rpx;position:relative}
.date-choice::after{content:'⌄';position:absolute;right:24rpx;top:20rpx;color:#69817a}
button{box-sizing:border-box;font-size:28rpx;line-height:1.5;border-radius:18rpx;padding:24rpx;white-space:normal;word-break:break-word}
button::after{border:none}
.choice{margin:16rpx 0;text-align:left;color:#315e55;background:#fff;border:2rpx solid #dbe6e1;font-size:27rpx}
.primary{margin-top:32rpx;background:#176f61;color:#fff;font-weight:600;min-height:96rpx;box-shadow:0 8rpx 20rpx rgba(23,111,97,.1)}
button[disabled]{background:#e6ece9;color:#8b9e97;box-shadow:none;border-color:#e0e7e3}
.hint,.notice{display:block;font-size:24rpx;color:#637c73;margin-top:16rpx;line-height:1.7;word-break:break-word;overflow-wrap:anywhere}
.notice{padding:24rpx;background:#edf4f0;border:2rpx solid #cbded4;border-radius:18rpx;color:#315e55;margin-top:28rpx}
.loading-hint{text-align:center;color:#637c73;font-size:24rpx;margin-top:24rpx}
.home-hero{padding:36rpx;border-radius:28rpx;background:linear-gradient(135deg,#dfeee5,#edf4ec);border:2rpx solid #d8e8dd}
.hero-kicker{font-size:23rpx;color:#587d69;letter-spacing:2rpx}
.hero-title{font-size:52rpx;line-height:1.35;font-weight:700;margin:20rpx 0;color:#214c40}
.hero-copy{font-size:25rpx;color:#5f7d70;line-height:1.8;max-width:530rpx}
.hero-action{display:flex;justify-content:space-between;align-items:center;margin-top:28rpx;text-align:left;padding:24rpx 28rpx}
.hero-action text{font-size:34rpx;font-weight:400}
.service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}
.service-tile{position:relative;margin:0;padding:26rpx 22rpx;text-align:left;background:#fff;border:2rpx solid #e2e9e5;min-width:0}
.service-icon{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:20rpx;background:#edf4ef;color:#28725d;font-size:29rpx;font-weight:600;margin-bottom:26rpx}
.service-name{font-size:30rpx;font-weight:600;line-height:1.5}
.service-copy{font-size:22rpx;color:#74897f;margin-top:8rpx;font-weight:400;line-height:1.6}
.tile-arrow{position:absolute;right:24rpx;top:28rpx;color:#8aa497;font-size:27rpx}
.profile-entry{display:flex;align-items:center;justify-content:space-between;background:#fff;text-align:left;margin:20rpx 0;padding:26rpx;border:2rpx solid #e2e9e5}
.profile-entry>text{font-size:38rpx;color:#8aa497}
.home-note{font-size:23rpx;color:#7b8e86;text-align:center;margin:30rpx 12rpx}
.text-button{background:transparent;color:#74897f;font-size:24rpx;margin:12rpx 0;padding:20rpx}
.record-card{margin:20rpx 0;padding:26rpx;background:#fff;border:2rpx solid #e0e9e3;border-radius:22rpx;word-break:break-word;font-size:28rpx;line-height:1.8}
.record-card>.hint{margin-top:10rpx}
.record-card .choice{background:#f3f7f4}
.screen-profile .field,.screen-appointment-detail .field{display:flex;justify-content:space-between;gap:24rpx;background:#fff;border-radius:16rpx;padding:24rpx;margin:14rpx 0;font-size:27rpx}
.screen-profile .field>text:first-child,.screen-appointment-detail .field>text:first-child{color:#75877f;flex-shrink:0}
.screen-profile .field>text:last-child,.screen-appointment-detail .field>text:last-child{text-align:right;word-break:break-word;min-width:0}
.screen-history-detail .field{background:#fff;padding:24rpx;border-radius:18rpx;margin:16rpx 0;word-break:break-word}
.screen-history-detail .field>view+view{margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #e8eee9}
.flow-guide{display:flex;flex-wrap:wrap;gap:12rpx;margin:0 0 26rpx;color:#618276;font-size:22rpx}
.flow-guide text{padding:8rpx 14rpx;background:#e6eee8;border-radius:10rpx}
.slot-heading{display:flex;justify-content:space-between;font-size:27rpx;font-weight:600;margin:28rpx 0 16rpx}
.slot-heading text{font-size:23rpx;color:#7b8d84;font-weight:400}
.slot-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-top:16rpx}
.slot-option{margin:0;text-align:center;padding:20rpx 10rpx;min-width:0}
.slot-time{font-size:28rpx;font-weight:600;line-height:1.5}
.slot-state{font-size:22rpx;margin-top:6rpx;color:#71897e}
.slot-selected{border-color:#217960;background:#e1efe6;color:#155a44;box-shadow:inset 0 0 0 1rpx #217960}
.slot-selected .slot-state{color:#155a44;font-weight:600}
.slot-option[disabled] .slot-state{color:#8b9e97}
.selection-summary{display:block;margin-top:26rpx;padding:24rpx;background:#e7f1e9;border-radius:20rpx;font-size:26rpx;line-height:1.8}
.selection-summary label{font-weight:400;margin:0}
.selection-summary checkbox{transform:scale(.85);transform-origin:left center}
.login-panel{padding:8rpx 0}
@media (min-width:600px){.card{max-width:850rpx;margin:0 auto}.slot-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}

.invoice-panel{background:#fff;border:2rpx solid #e0e9e3;border-radius:22rpx;overflow:hidden;margin:20rpx 0}
.invoice-meta{display:flex;justify-content:space-between;align-items:flex-start;gap:16rpx;padding:26rpx 22rpx;font-size:26rpx;word-break:break-word}
.invoice-meta .hint{margin-top:4rpx;font-size:21rpx}
.invoice-status{flex-shrink:0;padding:4rpx 12rpx;background:#e8f2ec;color:#276b54;border-radius:10rpx;font-size:23rpx}
.invoice-scroll{width:100%;box-sizing:border-box}
.invoice-table{min-width:620rpx}
.invoice-row{display:flex;align-items:flex-start;gap:12rpx;padding:22rpx;border-bottom:1rpx solid #e8eeea;font-size:25rpx;line-height:1.65}
.invoice-head{background:#eef4ef;color:#5c786a;font-size:23rpx;font-weight:600}
.invoice-project{flex:1;min-width:0;word-break:break-word}
.invoice-quantity{width:80rpx;flex-shrink:0;text-align:right;overflow-wrap:anywhere}
.invoice-unit{display:block;color:#7a8d83;font-size:21rpx}
.invoice-money{width:118rpx;flex-shrink:0;text-align:right;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}
.invoice-total{display:flex;justify-content:space-between;gap:16rpx;padding:24rpx 22rpx;font-weight:700;font-size:29rpx;color:#21644d}
.reminder-panel{margin:0 0 28rpx;padding:26rpx;border:2rpx solid #d9dfc2;background:#f5f6e9;border-radius:22rpx;font-size:26rpx;line-height:1.7;word-break:break-word}
.reminder-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:30rpx;font-weight:600;color:#445e36}
.reminder-window{font-size:21rpx;font-weight:400;color:#7a845b;flex-shrink:0}
.reminder-item{padding:20rpx 0;border-bottom:1rpx solid #e0e5d2}
.reminder-countdown{font-size:34rpx;font-weight:700;color:#526c37;margin-bottom:6rpx}
.reminder-empty{font-size:25rpx;color:#718063;margin-top:18rpx}
.reminder-actions{display:flex;flex-wrap:wrap;gap:16rpx;justify-content:flex-start}
.reminder-actions .text-button{width:auto;padding:12rpx 0;margin:6rpx 0;color:#4d6c3c;font-size:24rpx}
.reminder-note{display:block;font-size:21rpx;color:#7b876b;margin-top:6rpx}
