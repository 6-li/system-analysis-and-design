# Template only: no real credentials. Do not copy unchanged or commit a populated file.
# Dedicated course deployment, HTTPS reverse proxy -> loopback Spring Boot.
ADC_COURSE_PUBLIC_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
ADC_COURSE_STAFF_BUNDLE=/opt/adc-course/staff
# Explicit SYNTHETIC directory matching the separately approved demo dataset.
ADC_COURSE_CLINIC_ID=81001
ADC_COURSE_DENTIST_ID=79001
ADC_COURSE_CLINIC_ZONE=Asia/Shanghai
ADC_COURSE_DATABASE=adc_course_validation
# Example dedicated port only. Must match the approved local PostgreSQL installation.
ADC_COURSE_DATABASE_PORT=55432
# Set seven DIFFERENT passwords in the protected runtime.env, not this template.
ADC_DEMO_RECEPTION=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_DENTIST=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_BILLING=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_PROCUREMENT=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_MANAGER=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_OPERATIONS=REPLACE_WITH_UNIQUE_SECRET
ADC_DEMO_FINANCE=REPLACE_WITH_UNIQUE_SECRET
ADC_COURSE_DB_HEALTH_PASSWORD=REPLACE_WITH_DATABASE_ROLE_SECRET
# Keep operations closed until that environment's schema, IDs, ACL and smoke are checked.
ADC_UC07_ENABLED=false
ADC_UC08_ENABLED=false
ADC_UC09_ENABLED=false
ADC_COURSE_INBOX_ENABLED=false
# Reuse the existing scoped identity; install the approved mini source extension/read grants first.
ADC_COURSE_DB_PATIENT_INTAKE_PASSWORD=REPLACE_WITH_DATABASE_ROLE_SECRET
# No real patient data, cloud resources, or automatic migrations are enabled by this file.
# Optional synthetic booking selection/confirmation; no automatic database installation.
ADC_COURSE_BOOKING_INTERACTION_ENABLED=false
# Explicit SYNTHETIC dentist associations only; match your approved demo directory.
ADC_COURSE_SYNTHETIC_DENTIST_IDS=79001,79002,79003
# Mini profile read is opt-in. Existing grants are NOT upgraded automatically.
# Requires a deployment-owned verified SELF grant with PATIENT_PROFILE_READ,
# the approved four-column patient SELECT, and the existing mini session/read adapters.
ADC_MINI_PROFILE_READ_ENABLED=false
ADC_MINI_BOOKING_OPTIONS_ENABLED=false
ADC_MINI_APPOINTMENT_READ_ENABLED=false
ADC_COURSE_PATIENT_GRANTS_FILE=/etc/adc-course/patient-grants.json
ADC_COURSE_DB_MINI_READ_PASSWORD=REPLACE_WITH_DATABASE_ROLE_SECRET
