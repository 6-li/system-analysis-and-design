# Candidate for a dedicated course host. Replace the reserved domain and certificate paths.
limit_req_zone $binary_remote_addr zone=adc_course_login:10m rate=10r/m;

server {
    listen 80;
    server_name course.example.invalid;
    return 308 https://course.example.invalid$request_uri;
}

server {
    listen 443 ssl;
    server_name course.example.invalid;
    ssl_certificate /etc/adc-course/tls/fullchain.pem;
    ssl_certificate_key /etc/adc-course/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 256k;
    proxy_set_header Host course.example.invalid;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host course.example.invalid;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Forwarded "";

    location = /actuator { return 404; }
    location ^~ /actuator/ { return 404; }

    location = /demo/login {
        limit_req zone=adc_course_login burst=8 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
    }
    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
