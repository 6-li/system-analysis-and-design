            "schema": {
              "type": "string"
            }
          },
          {
            "name": "statisticId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Frozen record or bounded exact-scope list; list includes items and optional nextBeforeId"
          },
          "400": {
            "description": "Invalid or unavailable record"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role, scope or CSRF denied"
